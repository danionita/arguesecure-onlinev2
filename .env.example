## Application ---------------------------------------------------------
APP_NAME=ArgueSecure
APP_ENV=production
APP_DEBUG=false
# The real public HTTPS URL. Queued jobs and Reverb use this to build links,
# since they have no incoming request to infer scheme/host from.
APP_URL=https://arguesecure.example.com

# Leave empty. Generated on first container start and persisted to
# storage/app/config/app.key — see docs/specs/deployment.md §6.
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

## Image -------------------------------------------------------------------
# The images to pull, or the name and tag `docker compose up --build` gives
# the ones it builds (docs/specs/deployment.md §2.4). `latest` follows the
# newest release; pin one (2.6.3) or a minor line (2.6) to control upgrades.
# A second stack on the same host needs a tag of its own.
ARGUESECURE_VERSION=latest
# ARGUESECURE_IMAGE=ghcr.io/danionita/arguesecure

## Host-side placement --------------------------------------------------
# Unraid:    DATA_PATH=/mnt/<pool>/appdata/arguesecure
# Elsewhere: leave unset to use ./data
DATA_PATH=
APP_PORT=8000

## Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=arguesecure
DB_USERNAME=arguesecure
DB_PASSWORD=
DB_ROOT_PASSWORD=

## Redis — cache, sessions, queue, locks, broadcast auth -----------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

## Reverb (real-time) ------------------------------------------------------
# REVERB_APP_ID/KEY/SECRET are generated on first run alongside APP_KEY and
# shared by every container through storage/app/config/app.key. Never set
# them here.
#
# These three are where the *app* container posts broadcasts to, so they name
# the internal compose service — not a public hostname. Reverb is never
# published to the host.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
#
# Where the *browser* dials. Leave unset: nginx proxies /app to the reverb
# container, so the websocket uses the page's own origin whatever hostname,
# port and scheme it is served on, and one built image works in every
# deployment. Set them only for a proxy-less local run (`php artisan serve`
# plus `php artisan reverb:start`), e.g. localhost / 8080 / http.
# REVERB_CLIENT_HOST=
# REVERB_CLIENT_PORT=
# REVERB_CLIENT_SCHEME=
#
# Maximum broadcast size, in bytes. Both must be set together — one governs
# the publish Reverb accepts over HTTP, the other the per-app message — and
# raising only one still drops the payload.
#
# config/reverb.php defaults both to 1 MB rather than Reverb's own 10 KB,
# which is Pusher's chat-message budget: a totals broadcast carries a whole
# calculation result and costs roughly 1 KB per node, so 10 KB was exceeded
# by a seventeen-node assessment and live totals silently stopped updating.
# 1 MB covers around a thousand nodes. Raise these only if assessments are
# larger than that; every connected client receives the whole payload on
# every change.
# REVERB_MAX_REQUEST_SIZE=1000000
# REVERB_APP_MAX_MESSAGE_SIZE=1000000

## Product defaults ---------------------------------------------------------
ARGUESECURE_DEFAULT_CURRENCY=EUR
ARGUESECURE_AMORTIZATION_YEARS=3
TRASH_RETENTION_DAYS=30

## Assistant (optional, off by default) -------------------------------------
# The local inference assistant (docs/ASSISTANT.md). Most deployments will not
# run this: it needs a model file and 6 GiB of RAM for the small model, 28 GiB
# for the large one. Leaving ASSISTANT_ENABLED unset is a fully supported
# state — the app registers no assistant routes and the admin page offers no
# toggle.
#
# Turning it on: set ASSISTANT_ENABLED=true, then
#
#   docker compose run --rm assistant-install small     # or: large
#   docker compose --profile assistant up -d
#
# and switch it on under Admin → AI assistant. The installer downloads the
# model from its publisher at a pinned revision and checks its size and
# sha256 before the runtime can use it (docs/PLAN-2.6.md D53).
ASSISTANT_ENABLED=false
#
# Where model files live on the host. Defaults to ./models, beside this file.
# On Unraid, a pool path (/mnt/<pool>/...) rather than /mnt/user/...
# ASSISTANT_MODEL_PATH=/path/on/the/host/to/models
#
# Which model runs, first match wins (D54): a GGUF by file name; a preset,
# `small` or `large`; otherwise whichever preset was installed last.
# ASSISTANT_MODEL_FILE=
# ASSISTANT_MODEL=small
#
# CPU cores the assistant may use. Sets the runtime's threads and the
# container's CPU quota together — threads above the quota make it slower —
# and past four to six cores generation barely improves (spikes/2.3-threads).
# ASSISTANT_THREADS=4
#
# Internal compose service; never published to the host.
# ASSISTANT_BASE_URL=http://assistant:8080
#
# Timeouts, in seconds. CPU generation runs for minutes — a summary of a
# 73-node assessment measured 249s — so these are deliberately enormous and
# deliberately explicit. `stream_idle` is the one that protects anything: it
# catches a wedged runtime without cutting off a generation that is merely
# long.
# ASSISTANT_CONNECT_TIMEOUT=3
# ASSISTANT_STREAM_IDLE_TIMEOUT=120
# ASSISTANT_TOTAL_TIMEOUT=900
# ASSISTANT_HEALTH_TTL=30
#
# Generation budgets, in tokens. This is the latency dial and very nearly the
# only one, because output tokens cost roughly ten times what prompt tokens
# do. Lowering them makes the assistant faster and its answers worse.
# ASSISTANT_MAX_TOKENS_HELP=320
# ASSISTANT_MAX_TOKENS_SUGGESTIONS=512
# ASSISTANT_MAX_TOKENS_SUMMARY=700
#
# Must match the container's `-c`. The runtime silently truncates a longer
# prompt rather than erroring.
# ASSISTANT_CONTEXT_TOKENS=12288
